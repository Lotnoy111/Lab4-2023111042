<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- Maven 模型版本（固定为 4.0.0） -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 项目坐标（与你的 Github 仓库/Lab4 实验匹配） -->
    <groupId>org.example</groupId>
    <artifactId>Lab4</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>  <!-- 打包类型，实验用 jar 即可 -->

    <!-- 项目描述信息 -->
    <name>Lab4</name>
    <url>http://maven.apache.org</url>

    <!-- 核心配置：JDK 21 编译版本 + 编码格式（合并重复的 properties 标签） -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>  <!-- 统一编码，避免乱码 -->
        <maven.compiler.source>21</maven.compiler.source>  <!-- 适配你的 OpenJDK 21 -->
        <maven.compiler.target>21</maven.compiler.target>  <!-- 编译目标版本与 JDK 一致 -->
    </properties>

    <!-- 依赖配置（保留实验要求的 JUnit 4.13.1，删除重复的 JUnit 3.8.1） -->
    <<dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.1</version>  <!-- 实验手册指定版本，支持 JDK 8+（含 21） -->
            <scope>test</scope>  <!-- 仅测试环境生效，符合实验需求 -->
        </dependency>
    </</dependencies>

</project>  <!-- 根标签，必须是文件最后一行，之后无任何内容 -->
